# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git

# LLM — OpenAI-compatible endpoint (required)
VITE_LLM_BASE_URL=https://your-proxy.com/v1
VITE_LLM_API_KEY=sk-...
VITE_LLM_MODEL=gpt-4o

# Voice STT provider — "webspeech" (free, browser-native) | "groq" (Whisper, high quality)
# Set to "groq" and add VITE_GROQ_API_KEY for significantly better transcription accuracy.
# Recommended model: whisper-large-v3-turbo (auto-selected inside groqStt.ts)
VITE_STT_PROVIDER=webspeech

# Groq API key — required when VITE_STT_PROVIDER=groq
# Get a free key at https://console.groq.com → API Keys
# Free tier: 28,800 audio-seconds/day — more than enough for personal use
# VITE_GROQ_API_KEY=gsk_...

# Supabase — required for Phase 2+, not needed for Phase 1
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

