# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git

# LLM — OpenAI-compatible endpoint (required)
VITE_LLM_BASE_URL=https://your-proxy.com/v1
VITE_LLM_API_KEY=sk-...
VITE_LLM_MODEL=gpt-4o

# Voice providers — defaults to browser Web Speech API
# Options: "webspeech" | "groq"
VITE_STT_PROVIDER=webspeech
VITE_TTS_PROVIDER=webspeech

# Groq API key — only needed if using VITE_STT_PROVIDER=groq or VITE_TTS_PROVIDER=groq
# VITE_GROQ_API_KEY=gsk_...

# Supabase — required for Phase 2+, not needed for Phase 1
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

